# ── Server ───────────────────────────────────────────────
PORT=3100
# Protect the page with HTTP basic auth (any username, this password). Required in production.
DASHBOARD_PASSWORD=
# Where synced data and refreshed tokens are stored.
DATA_DIR=./data
# History fetched on startup / days re-fetched on each scheduled sync.
BACKFILL_DAYS=90
RESYNC_DAYS=3
# Fill any source without credentials with sample data (automatic when none are set).
DEMO_MODE=false

# Public address of this dashboard (used for the Oura sign-in redirect), e.g. https://health-production.up.railway.app
PUBLIC_URL=

# ── Oura Ring (official API v2, OAuth) ───────────────────
# Create an app at https://cloud.ouraring.com/oauth/applications with redirect URI
# <PUBLIC_URL>/auth/oura/callback, then press "Connect Oura" in the dashboard.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_SYNC_MINUTES=30

# ── Garmin Connect (unofficial) ──────────────────────────
# Prefer the Connections panel: it supports two-step verification and never stores your password.
# Optional fallback for accounts without two-step verification:
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_SYNC_MINUTES=15

# ── MyFitnessPal (no public API) ─────────────────────────
# Prefer the Connections panel. Optional fallback: username plus the Cookie header
# from a logged-in browser (not needed if your diary is public).
MFP_USERNAME=
MFP_COOKIE=
MFP_SYNC_MINUTES=10
