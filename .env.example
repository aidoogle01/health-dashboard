# ── Server ───────────────────────────────────────────────
PORT=3100
# Protect the page with HTTP basic auth (any username, this password). Strongly recommended.
DASHBOARD_PASSWORD=
# Where synced data and refreshed tokens are stored.
DATA_DIR=./data
# History fetched on startup / days re-fetched on each scheduled sync.
BACKFILL_DAYS=90
RESYNC_DAYS=3
# Fill any source without credentials with sample data (automatic when none are set).
DEMO_MODE=false

# ── Oura Ring (official API v2) ──────────────────────────
# Either an access token alone, or OAuth client + refresh token for hands-off renewal.
OURA_ACCESS_TOKEN=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REFRESH_TOKEN=
OURA_SYNC_MINUTES=30

# ── Garmin Connect (unofficial) ──────────────────────────
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_DOMAIN=garmin.com
GARMIN_SYNC_MINUTES=15

# ── MyFitnessPal (no public API) ─────────────────────────
MFP_USERNAME=
# Full Cookie header from a logged-in browser session. Not needed if your diary is public.
MFP_COOKIE=
MFP_SYNC_MINUTES=10
